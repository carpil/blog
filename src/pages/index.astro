---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import NewsletterSection from "../components/NewsletterSection.astro";
import CountdownTimer from "../components/CountdownTimer.astro";
import HowItWorks from "../components/HowItWorks.astro";
import Footer from "../components/Footer.astro";
import StickyCTA from "../components/StickyCTA.astro";

const seo = {
  title: 'Carpil - La app de carpooling para Costa Rica',
  description: 'Conectá con conductores y pasajeros en tu ruta. Ahorrá hasta 60% en transporte y ayudá al planeta. Acceso anticipado disponible.',
};
---

<Layout 
  title={seo.title}
  description={seo.description}
>
  <Header />
  <Hero />
  <StickyCTA />
  <NewsletterSection />
  <CountdownTimer />
  <HowItWorks />
  <Footer />
</Layout>
