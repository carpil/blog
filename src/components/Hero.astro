---
import AndroidBetaModal from "./AndroidBetaModal.tsx"
---

<section class="hero bg-white py-12 lg:py-20 relative">
  <div class="container mx-auto px-4 w-full">
    <div class="max-w-4xl mx-auto text-center">
      <!-- Banner simplificado -->
      <div
        class="inline-flex items-center gap-2 px-4 py-2 bg-primary/10 border border-primary/20 rounded-full mb-6"
      >
        <span class="text-xl">🎉</span>
        <span class="font-body text-sm text-primary font-medium">
          Versión 1.0 ya disponible
        </span>
      </div>

      <!-- Slogan principal - Emocional y memorable -->
      <h1
        class="font-heading text-4xl lg:text-6xl font-extrabold mb-6 leading-tight"
      >
        <span class="text-dark">Viajamos juntos.</span>
        <br />
        <span class="text-primary">Ahorramos juntos.</span>
      </h1>

      <!-- Beneficios como badges sutiles - Reemplaza el párrafo -->
      <div class="flex flex-wrap justify-center gap-2 mb-8 max-w-2xl mx-auto">
        <span
          class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-primary/5 border border-primary/10 rounded-full text-sm text-dark font-medium"
        >
          <span class="text-base">💰</span>
          <span>Ahorra hasta 60%</span>
        </span>
        <span
          class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-primary/5 border border-primary/10 rounded-full text-sm text-dark font-medium"
        >
          <span class="text-base">🚗</span>
          <span>Reduce tráfico</span>
        </span>
        <span
          class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-primary/5 border border-primary/10 rounded-full text-sm text-dark font-medium"
        >
          <span class="text-base">🌱</span>
          <span>Cuida el planeta</span>
        </span>
      </div>

      <!-- App Store Badges - En la misma línea para igualdad de plataformas -->
      <div
        class="flex flex-row flex-wrap gap-2 sm:gap-4 justify-center items-center mb-8"
      >
        <AndroidBetaModal client:load />

        <a
          href="https://apps.apple.com/cr/app/carpil-viajes-compartidos/id6754807330"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 sm:gap-3 px-4 sm:px-6 py-3 bg-black border-2 border-black rounded-lg hover:bg-gray-800 transition-colors min-w-[140px] sm:min-w-[160px]"
        >
          <svg
            class="w-7 h-7 sm:w-8 sm:h-8 flex-shrink-0 text-white"
            viewBox="0 0 24 24"
            fill="currentColor"
          >
            <path
              d="M17.05 20.28c-.98.95-2.05.88-3.08.4-1.09-.5-2.08-.48-3.24 0-1.44.62-2.2.44-3.06-.4C1.79 15.25 2.28 7.59 9.5 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09l.01-.01zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"
            ></path>
          </svg>
          <div class="text-left">
            <div class="font-body text-xs text-gray-300">Disponible en</div>
            <div class="font-heading text-sm font-bold text-white">
              App Store
            </div>
          </div>
        </a>
      </div>

    </div>
  </div>
</section>
