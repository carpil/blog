---
interface Props {
  size?: number;
  class?: string;
}

const { size = 15, class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  aria-label="Verificado"
  role="img"
>
  <path
    d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"
    fill="#ffffff"
    fill-opacity="0.9"></path>
  <path
    d="M9 12l2 2 4-4"
    stroke="#6c47ff"
    stroke-width="2.2"
    stroke-linecap="round"
    stroke-linejoin="round"></path>
</svg>
