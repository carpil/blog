---
// Social media URLs - can be moved to env variables later
const socialLinks = {
  instagram: "https://www.instagram.com/carpil.app/",
  twitter: "https://x.com/ridewithcarpil",
  tiktok: "https://www.tiktok.com/@carpil.app",
};
---

<section class="confirmation-success bg-white py-12 lg:py-20">
  <div class="container mx-auto px-4">
    <div class="max-w-4xl mx-auto text-center">
      <!-- Success Message -->
      <div class="mb-12">
        <div
          class="inline-flex items-center justify-center w-20 h-20 bg-primary/10 rounded-full mb-6"
        >
          <span class="text-5xl">🎉</span>
        </div>
        <h1
          class="font-heading text-4xl lg:text-6xl font-extrabold mb-4 leading-tight"
        >
          <span class="text-dark">¡Estás dentro!</span>
        </h1>
        <p class="font-body text-xl lg:text-2xl text-carpil-gray mb-2">
          Gracias por unirte al acceso anticipado
        </p>
        <p
          class="font-body text-base lg:text-lg text-carpil-gray max-w-2xl mx-auto"
        >
          Te avisaremos cuando lancemos. Mientras tanto, seguinos en nuestras
          redes para estar al día con el progreso.
        </p>
      </div>

      <!-- Social Media Section -->
      <div class="mb-12">
        <h2 class="font-heading text-2xl lg:text-3xl font-bold text-dark mb-8">
          Seguinos para no perderte nada
        </h2>

        <div
          class="flex flex-col sm:flex-row gap-4 justify-center items-stretch max-w-2xl mx-auto"
        >
          <!-- Instagram -->
          <a
            href={socialLinks.instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-3 px-6 py-4 bg-white border-2 border-gray-200 rounded-lg hover:border-primary hover:shadow-md transition-all min-h-[80px] min-w-[200px] sm:flex-1"
            aria-label="Seguir a Carpil en Instagram"
          >
            <svg
              class="w-8 h-8 flex-shrink-0"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"
              ></path>
            </svg>
            <div class="text-left flex-1">
              <div class="font-body text-xs text-carpil-gray mb-1">
                SIGUENOS
              </div>
              <div class="font-heading text-base font-bold text-dark">
                Instagram
              </div>
            </div>
          </a>

          <!-- Twitter/X -->
          <a
            href={socialLinks.twitter}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-3 px-6 py-4 bg-white border-2 border-gray-200 rounded-lg hover:border-primary hover:shadow-md transition-all min-h-[80px] min-w-[200px] sm:flex-1"
            aria-label="Seguir a Carpil en Twitter/X"
          >
            <svg
              class="w-8 h-8 flex-shrink-0"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
              ></path>
            </svg>
            <div class="text-left flex-1">
              <div class="font-body text-xs text-carpil-gray mb-1">
                SIGUENOS
              </div>
              <div class="font-heading text-base font-bold text-dark">
                Twitter/X
              </div>
            </div>
          </a>

          <!-- TikTok -->
          <a
            href={socialLinks.tiktok}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-3 px-6 py-4 bg-white border-2 border-gray-200 rounded-lg hover:border-primary hover:shadow-md transition-all min-h-[80px] min-w-[200px] sm:flex-1"
            aria-label="Seguir a Carpil en TikTok"
          >
            <svg
              class="w-8 h-8 flex-shrink-0"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z"
              ></path>
            </svg>
            <div class="text-left flex-1">
              <div class="font-body text-xs text-carpil-gray mb-1">
                SIGUENOS
              </div>
              <div class="font-heading text-base font-bold text-dark">
                TikTok
              </div>
            </div>
          </a>
        </div>
      </div>

      <!-- CTA to go back home -->
      <div>
        <a
          href="/"
          class="inline-flex px-8 py-3 bg-gray-100 text-dark rounded-lg font-heading font-bold text-base hover:bg-gray-200 transition-colors min-h-[48px] items-center justify-center"
          aria-label="Volver al inicio"
        >
          Volver al inicio
        </a>
      </div>
    </div>
  </div>
</section>
