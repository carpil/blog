---
const safetyFeatures = [
  {
    icon: "✅",
    title: "Conductores Verificados",
    description: "Todos los conductores son estudiantes universitarios verificados con identificación oficial."
  },
  {
    icon: "📍",
    title: "Tracking en Tiempo Real",
    description: "Comparte tu ubicación en tiempo real con tus contactos de confianza durante el viaje."
  },
  {
    icon: "🛡️",
    title: "Seguro de Viaje",
    description: "Todos los viajes están cubiertos por nuestro seguro de responsabilidad civil."
  },
  {
    icon: "⭐",
    title: "Sistema de Calificaciones",
    description: "Califica a conductores y pasajeros después de cada viaje para mantener la comunidad segura."
  },
  {
    icon: "🚨",
    title: "Botón de Emergencia",
    description: "Acceso rápido a servicios de emergencia directamente desde la app."
  },
  {
    icon: "👮",
    title: "Estándares de la Comunidad",
    description: "Políticas claras y reportes rápidos para mantener un ambiente seguro para todos."
  }
];
---

<section class="trust-safety py-20 bg-dark">
  <div class="container mx-auto px-4">
    <div class="text-center mb-16">
      <h2 class="font-heading text-3xl lg:text-5xl font-bold text-white mb-4">
        Tu seguridad es nuestra prioridad
      </h2>
      <p class="font-body text-xl text-carpil-gray max-w-2xl mx-auto">
        Implementamos múltiples medidas de seguridad para que viajes con total confianza
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {safetyFeatures.map((feature) => (
        <div class="safety-card bg-dark-light p-6 rounded-xl hover:shadow-lg transition-all duration-300">
          <div class="text-4xl mb-4">{feature.icon}</div>
          <h3 class="font-heading text-xl font-bold text-white mb-3">
            {feature.title}
          </h3>
          <p class="font-body text-base text-carpil-gray leading-relaxed">
            {feature.description}
          </p>
        </div>
      ))}
    </div>

    <!-- Trust badges -->
    <div class="mt-16 text-center">
      <div class="flex flex-wrap justify-center items-center gap-8 text-carpil-gray">
        <div class="flex items-center gap-2">
          <span class="text-2xl">🔐</span>
          <span class="font-body">Datos encriptados</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-2xl">✓</span>
          <span class="font-body">Verificación de identidad</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-2xl">🛡️</span>
          <span class="font-body">Seguro incluido</span>
        </div>
      </div>
    </div>
  </div>
</section>
