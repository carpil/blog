---
import NotFound from "../../components/share/NotFound.astro";
import SharePage from "../../components/share/SharePage.astro";
import type { SharePageProps } from "../../components/share/types";
import ShareLayout from "../../layouts/ShareLayout.astro";
import { getRide } from "../../lib/api";
import {
  formatDateShort,
  formatPrice,
  formatTime,
  seatsBadgeLabel,
  seatsLabel,
} from "../../lib/format";
import { deepLink, shareUrl } from "../../lib/share-links";

const { id } = Astro.params;
const ride = await getRide(id!);

const origin = ride?.origin?.name.primary ?? "Origen";
const destination = ride?.destination?.name.primary ?? "Destino";

const title = ride
  ? `${origin} → ${destination} — Carpil`
  : "Viaje no encontrado — Carpil";

const description = ride
  ? `${formatDateShort(ride.departureDate)} · ${formatTime(ride.departureDate)} · ${formatPrice(ride.price)} por asiento · ${seatsLabel(ride.availableSeats)}`
  : "Este viaje no existe o fue eliminado por el conductor.";

const ogImage = ride
  ? new URL(`/api/og/ride/${id}.png`, Astro.url.origin).href
  : undefined;

const page: SharePageProps | null = ride
  ? {
      deepLink: deepLink("ride", ride.id),
      shareUrl: shareUrl("ride", ride.id),
      shareTitle: title,
      shareText: `Voy de ${origin} a ${destination} el ${formatDateShort(ride.departureDate)}. Unite por acá:`,
      shareLabel: "O compartí este viaje",
      ctaLabel: "Unirme al viaje",
      captionMobile:
        "Se abre en la app. Si no la tenés, te llevamos a la tienda.",
      captionDesktop:
        "Escaneá o abrí este enlace en tu celular para unirte desde la app.",
      card: {
        badge: seatsBadgeLabel(ride.availableSeats),
        origin,
        destination,
        chips: [
          { icon: "calendar", label: formatDateShort(ride.departureDate) },
          { icon: "clock", label: formatTime(ride.departureDate) },
          {
            icon: "banknote",
            label: `${formatPrice(ride.price)} por asiento`,
          },
          { icon: "users", label: seatsLabel(ride.availableSeats) },
        ],
        personOverline: "Conduce",
        personName: ride.driver.name,
        personPhoto: ride.driver.profilePicture,
        personVerified: true,
        seatStack: {
          passengers: ride.passengers.map((passenger) => ({
            name: passenger.name,
            photo: passenger.profilePicture,
          })),
          freeSeats: ride.availableSeats,
        },
      },
      side: {
        label: "Viajá con Carpil",
        heading: "Sabes con quién viajas, cuánto pagas y cuándo sales.",
        body: "Carpil conecta conductores y pasajeros verificados para viajes entre ciudades en Costa Rica. Unite a este viaje desde la app.",
        bullets: [
          {
            icon: "shield-check",
            text: "Conductores verificados con cédula y licencia",
          },
          { icon: "banknote", text: "Pagás el precio publicado, sin sorpresas" },
          { icon: "messages-square", text: "Chat del viaje dentro de la app" },
        ],
      },
    }
  : null;
---

<ShareLayout title={title} description={description} image={ogImage}>
  {
    page ? (
      <SharePage {...page} />
    ) : (
      <div class="fallback">
        <NotFound
          title="Viaje no encontrado"
          message="Este viaje no existe, ya salió o fue cancelado por el conductor."
        />
      </div>
    )
  }
</ShareLayout>

<style>
  .fallback {
    max-width: 420px;
    margin: 0 auto;
    padding: 56px 24px;
  }
</style>
