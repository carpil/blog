---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { getEntry } from "astro:content";

const entry = await getEntry("docs", "terms");
if (!entry) throw new Error("Terms page not found");

const { Content } = await entry.render();
const { title, description, lastUpdated } = entry.data;

const formattedDate = lastUpdated.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<Layout title={title} description={description}>
  <Header />
  <main class="py-12 bg-white">
    <div class="container mx-auto px-4">
      <article class="max-w-4xl mx-auto">
        <div class="mb-8">
          <h1 class="text-4xl font-heading font-bold text-dark mb-2">
            {title}
          </h1>
          <p class="text-carpil-gray font-body text-lg">{description}</p>
          <p class="text-sm text-carpil-gray mt-2 font-body">
            Last updated: {formattedDate}
          </p>
        </div>
        <div class="legal-content font-body text-dark">
          <Content />
        </div>
      </article>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .legal-content :global(h1) {
    @apply text-3xl font-heading font-bold text-dark mt-8 mb-4;
  }

  .legal-content :global(h2) {
    @apply text-2xl font-heading font-semibold text-dark mt-6 mb-3;
  }

  .legal-content :global(h3) {
    @apply text-xl font-heading font-semibold text-dark mt-5 mb-2;
  }

  .legal-content :global(p) {
    @apply text-carpil-gray mb-4 leading-relaxed;
  }

  .legal-content :global(ul),
  .legal-content :global(ol) {
    @apply mb-4 text-carpil-gray space-y-2;
  }

  .legal-content :global(ul) {
    @apply list-disc list-inside;
  }

  .legal-content :global(ol) {
    @apply list-decimal list-inside;
  }

  .legal-content :global(li) {
    @apply ml-4;
  }

  .legal-content :global(strong) {
    @apply text-dark font-semibold;
  }

  .legal-content :global(a) {
    @apply text-primary hover:text-primary/80 underline;
  }

  .legal-content :global(blockquote) {
    @apply border-l-4 border-primary pl-4 italic text-carpil-gray my-4;
  }

  .legal-content :global(hr) {
    @apply border-t border-gray-200 my-8;
  }
</style>
