---
import "@fontsource/poppins/800.css";
import Layout from "../layouts/Layout.astro";
import JoinNewsletter from "../components/JoinNewsletter.tsx";
import Logo from "../components/Logo.astro";
---

<Layout title="Carpil | A Carpooling app">
  <main class="flex flex-1 h-full w-full">
    <section
      class="flex items-center sm:justify-between justify-center sm:flex-row flex-col w-full"
    >
      <JoinNewsletter client:load />
      <Logo />
    </section>
  </main>
</Layout>

<style>
  h1 {
    font-family: "Poppins", sans-serif;
  }
</style>
