---
import "@fontsource/poppins/800.css";
import Layout from "../layouts/Layout.astro";
import JoinNewsletter from "../components/JoinNewsletter.tsx";
---

<Layout title="Carpil | A Carpooling app">
  <main class="flex flex-1 h-full w-full">
    <section class="flex items-center justify-between sm:flex-row flex-col">
      <JoinNewsletter client:load />
      <div class="flex flex-col items-end justify-center pl-40">
        <h1 class="text-9xl text-white font-extrabold">Carpil</h1>
        <h3 class="text-3xl text-white mt-5">Coming Soon</h3>
      </div>
    </section>
  </main>
  <footer
    class="fixed bottom-0 flex items-center justify-center px-16 w-full left-0 right-0 mb-5"
  >
    <div class="text-dark-light text-sm">
      From 🇨🇷 by <a
        href="https://jrodolforojas.vercel.app"
        target="_blank"
        class="hover:text-white">Jose Rodolfo Rojas</a>
    </div>
  </footer>
</Layout>

<style>
  h1 {
    font-family: "Poppins", sans-serif;
  }
</style>
