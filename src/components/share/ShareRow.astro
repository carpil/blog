---
import Icon from "./Icon.astro";
import type { IconName } from "./icons";
import { facebookShareUrl, whatsappShareUrl } from "../../lib/share-links";

interface Props {
  label: string;
  text: string;
  url: string;
  title: string;
}

const { label, text, url, title } = Astro.props;

interface ShareAction {
  icon: IconName;
  mobileLabel: string;
  desktopLabel: string | null;
  href?: string;
  action?: "copy" | "native";
}

const actions: ShareAction[] = [
  {
    icon: "message-circle",
    mobileLabel: "WhatsApp",
    desktopLabel: "WhatsApp",
    href: whatsappShareUrl(text, url),
  },
  {
    icon: "facebook",
    mobileLabel: "Facebook",
    desktopLabel: "Facebook",
    href: facebookShareUrl(url),
  },
  {
    icon: "instagram",
    mobileLabel: "Instagram",
    desktopLabel: null,
    action: "copy",
  },
  {
    icon: "link",
    mobileLabel: "Copiar",
    desktopLabel: "Copiar enlace",
    action: "copy",
  },
  {
    icon: "share",
    mobileLabel: "Más",
    desktopLabel: null,
    action: "native",
  },
];
---

<section
  class="share"
  data-share
  data-url={url}
  data-text={text}
  data-title={title}
>
  <p class="share__label">{label}</p>

  <div class="share__row">
    {
      actions.map((action) => {
        const Tag = action.href ? "a" : "button";
        return (
          <Tag
            class:list={[
              "share__item",
              !action.desktopLabel && "share__item--mobile-only",
              action.action === "native" && "share__item--native",
            ]}
            {...(action.href
              ? { href: action.href, target: "_blank", rel: "noopener noreferrer" }
              : { type: "button", "data-action": action.action })}
          >
            <span class="share__icon">
              <Icon name={action.icon} size={22} />
            </span>
            <span class="share__text share__text--mobile">
              {action.mobileLabel}
            </span>
            <span class="share__text share__text--desktop">
              {action.desktopLabel}
            </span>
          </Tag>
        );
      })
    }
  </div>

  <p class="share__toast" data-toast role="status" aria-live="polite"></p>
</section>

<script>
  const root = document.querySelector<HTMLElement>("[data-share]");

  if (root) {
    const url = root.dataset.url!;
    const text = root.dataset.text!;
    const title = root.dataset.title!;
    const toast = root.querySelector<HTMLElement>("[data-toast]")!;
    let toastTimer = 0;

    const showToast = (message: string) => {
      toast.textContent = message;
      toast.classList.add("is-visible");
      window.clearTimeout(toastTimer);
      toastTimer = window.setTimeout(
        () => toast.classList.remove("is-visible"),
        2600,
      );
    };

    const nativeButton = root.querySelector<HTMLButtonElement>(
      ".share__item--native",
    );
    if (nativeButton && !navigator.share) nativeButton.hidden = true;

    root.querySelectorAll<HTMLButtonElement>("[data-action]").forEach((button) => {
      button.addEventListener("click", async () => {
        if (button.dataset.action === "native") {
          try {
            await navigator.share({ title, text, url });
          } catch {
            // El usuario canceló la hoja de compartir.
          }
          return;
        }

        try {
          await navigator.clipboard.writeText(url);
          showToast(
            button.classList.contains("share__item--mobile-only")
              ? "Enlace copiado — pegalo en tu historia"
              : "Enlace copiado",
          );
        } catch {
          showToast("No pudimos copiar el enlace");
        }
      });
    });
  }
</script>

<style>
  .share {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding-top: 8px;
  }

  .share__label {
    margin: 0;
    text-align: center;
    font-weight: 700;
    font-size: 11px;
    line-height: 16px;
    letter-spacing: 1.1px;
    text-transform: uppercase;
    color: var(--on-surface-variant);
  }

  .share__row {
    display: flex;
    justify-content: center;
    gap: 14px;
  }

  .share__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 0;
    border: none;
    background: none;
    color: inherit;
    font: inherit;
    cursor: pointer;
    transition: transform 150ms ease;
  }

  .share__item:active {
    transform: scale(0.97);
  }

  .share__item[hidden] {
    display: none;
  }

  .share__icon {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--surface-container-high);
    color: var(--primary);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .share__text {
    font-weight: 500;
    font-size: 10px;
    line-height: 14px;
    letter-spacing: 0.4px;
    color: var(--on-surface-variant);
  }

  .share__text--mobile {
    text-transform: uppercase;
  }

  .share__text--desktop {
    display: none;
  }

  .share__toast {
    margin: 0;
    text-align: center;
    font-size: 12px;
    color: var(--primary);
    opacity: 0;
    transition: opacity 200ms ease;
  }

  .share__toast.is-visible {
    opacity: 1;
  }

  @media (min-width: 1024px) {
    .share {
      padding-top: 0;
    }

    .share__label {
      display: none;
    }

    .share__row {
      gap: 12px;
    }

    .share__item--mobile-only {
      display: none;
    }

    .share__item {
      flex-direction: row;
      gap: 8px;
      padding: 10px 18px;
      border: 1px solid var(--border-ghost);
      border-radius: 9999px;
      background: var(--surface-container-low);
    }

    .share__icon {
      width: 16px;
      height: 16px;
      border-radius: 0;
      background: none;
      color: var(--on-surface-variant);
    }

    .share__icon :global(svg) {
      width: 16px;
      height: 16px;
    }

    .share__text--mobile {
      display: none;
    }

    .share__text--desktop {
      display: inline;
      font-weight: 600;
      font-size: 13px;
      letter-spacing: normal;
    }
  }
</style>
