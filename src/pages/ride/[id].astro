---
import Layout from "../../layouts/Layout.astro";
import { getRide } from "../../lib/api";

const { id } = Astro.params;
const ride = await getRide(id!);

function getInitials(name: string): string {
  return name
    .split(" ")
    .slice(0, 2)
    .map((n) => n[0])
    .join("")
    .toUpperCase();
}

function formatDate(iso: string): string {
  return new Date(iso).toLocaleDateString("es-CR", {
    weekday: "long",
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}

function formatTime(iso: string): string {
  return new Date(iso).toLocaleTimeString("es-CR", {
    hour: "2-digit",
    minute: "2-digit",
  });
}

const title = ride
  ? `${ride.origin?.name.primary} → ${ride.destination?.name.primary} — Carpil`
  : "Viaje no encontrado — Carpil";

const description = ride
  ? `Viaje de ${ride.origin?.name.primary} a ${ride.destination?.name.primary} el ${formatDate(ride.departureDate)}. ₡${ride.price.toLocaleString("es-CR")}`
  : "Este viaje no existe o fue eliminado.";
---

<Layout title={title} description={description} noindex={true}>
  <div class="ride-bg min-h-screen flex items-center justify-center px-4 py-10">
    <div class="w-full max-w-[420px]">

      {ride ? (
        <div class="flex flex-col gap-4">

          <!-- Driver -->
          <div class="ride-card flex items-center gap-4 p-5">
            {ride.driver.profilePicture ? (
              <img
                src={ride.driver.profilePicture}
                alt={ride.driver.name}
                class="avatar-img"
                width={52}
                height={52}
              />
            ) : (
              <div class="avatar">
                {getInitials(ride.driver.name)}
              </div>
            )}
            <div>
              <p class="label">Conductor</p>
              <p class="driver-name">{ride.driver.name}</p>
            </div>
          </div>

          <!-- Route -->
          <div class="ride-card p-5">
            <p class="label mb-3">Ruta</p>
            <div class="flex items-center gap-3">
              <div class="flex-1">
                <p class="place-label">Origen</p>
                <p class="place-name">{ride.origin?.name.primary}</p>
                <p class="place-secondary">{ride.origin?.name.secondary}</p>
              </div>
              <div class="arrow-circle">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                  <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
              <div class="flex-1 text-right">
                <p class="place-label">Destino</p>
                <p class="place-name">{ride.destination?.name.primary}</p>
                <p class="place-secondary">{ride.destination?.name.secondary}</p>
              </div>
            </div>
          </div>

          <!-- Meeting point (if present) -->
          {ride.meetingPoint && (
            <div class="ride-card p-5 flex gap-3 items-start">
              <div class="icon-wrap mt-0.5">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                  <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5S10.62 6.5 12 6.5s2.5 1.12 2.5 2.5S13.38 11.5 12 11.5z" fill="currentColor"/>
                </svg>
              </div>
              <div>
                <p class="label">Punto de encuentro</p>
                <p class="detail-text">{ride.meetingPoint.name.primary}</p>
                <p class="place-secondary">{ride.meetingPoint.name.secondary}</p>
              </div>
            </div>
          )}

          <!-- Date & time -->
          <div class="ride-card p-5 flex gap-3 items-start">
            <div class="icon-wrap mt-0.5">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                <rect x="3" y="4" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.8"/>
                <path d="M16 2v4M8 2v4M3 10h18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
              </svg>
            </div>
            <div>
              <p class="label">Salida</p>
              <p class="detail-text capitalize">{formatDate(ride.departureDate)}</p>
              <p class="time-text">{formatTime(ride.departureDate)}</p>
            </div>
          </div>

          <!-- Price + seats -->
          <div class="ride-card p-5 flex gap-3">
            <div class="flex-1 flex gap-3 items-center">
              <div class="icon-wrap">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                  <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.8"/>
                  <path d="M12 6v2m0 8v2M8.5 9.5h3a1.5 1.5 0 0 1 0 3h-3a1.5 1.5 0 0 0 0 3H15" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                </svg>
              </div>
              <div>
                <p class="label">Precio</p>
                <p class="time-text">₡{ride.price.toLocaleString("es-CR")}</p>
              </div>
            </div>
            <div class="flex gap-3 items-center">
              <div class="icon-wrap">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                  <circle cx="9" cy="7" r="4" stroke="currentColor" stroke-width="1.8"/>
                  <path d="M3 21v-2a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                  <path d="M16 3.13a4 4 0 0 1 0 7.75M21 21v-2a4 4 0 0 0-3-3.87" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                </svg>
              </div>
              <div>
                <p class="label">Asientos</p>
                <p class="time-text">{ride.availableSeats}</p>
              </div>
            </div>
          </div>

          <!-- CTA -->
          <a
            href="https://apps.apple.com/us/app/yo44007664"
            class="join-btn"
            target="_blank"
            rel="noopener noreferrer"
          >
            Unirse al viaje
          </a>

          <p class="text-center text-xs" style="color: #55566a">
            Necesitas la app Carpil para unirte
          </p>
        </div>
      ) : (
        <!-- Not found -->
        <div class="ride-card flex flex-col items-center gap-5 p-10 text-center">
          <div class="not-found-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none">
              <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.8"/>
              <path d="M12 8v4M12 16h.01" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
          </div>
          <div>
            <h1 class="not-found-title">Viaje no encontrado</h1>
            <p class="not-found-sub">Este viaje no existe o fue eliminado por el conductor.</p>
          </div>
          <a href="/" class="back-btn">Volver al inicio</a>
        </div>
      )}

    </div>
  </div>
</Layout>

<style>
  .ride-bg {
    background: #0d0d14;
    font-family: "Inter", system-ui, sans-serif;
  }

  .ride-card {
    background: #16161f;
    border: 1px solid #1e1e2e;
    border-radius: 16px;
  }

  .avatar {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: linear-gradient(135deg, #6f52ea, #a78bfa);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: "Poppins", sans-serif;
    font-weight: 700;
    font-size: 18px;
    color: #fff;
    flex-shrink: 0;
  }

  .avatar-img {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  .label {
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #55566a;
    margin-bottom: 2px;
  }

  .driver-name {
    font-family: "Poppins", sans-serif;
    font-size: 16px;
    font-weight: 600;
    color: #f0f0f8;
  }

  .place-label {
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #55566a;
    margin-bottom: 4px;
  }

  .place-name {
    font-family: "Poppins", sans-serif;
    font-size: 15px;
    font-weight: 600;
    color: #f0f0f8;
  }

  .place-secondary {
    font-size: 12px;
    color: #55566a;
    margin-top: 1px;
  }

  .arrow-circle {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #1e1e2e;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #6f52ea;
    flex-shrink: 0;
  }

  .icon-wrap {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: #1e1e2e;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #6f52ea;
    flex-shrink: 0;
  }

  .detail-text {
    font-size: 14px;
    color: #c8c8e0;
    line-height: 1.5;
  }

  .time-text {
    font-family: "Poppins", sans-serif;
    font-size: 18px;
    font-weight: 700;
    color: #f0f0f8;
    margin-top: 2px;
  }

  .join-btn {
    display: block;
    width: 100%;
    padding: 16px;
    background: #6f52ea;
    color: #fff;
    font-family: "Poppins", sans-serif;
    font-size: 16px;
    font-weight: 600;
    text-align: center;
    border-radius: 14px;
    text-decoration: none;
    transition: background 0.2s, transform 0.1s;
    margin-top: 4px;
  }

  .join-btn:hover {
    background: #5a3fd6;
  }

  .join-btn:active {
    transform: scale(0.98);
  }

  .not-found-icon {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: #1e1e2e;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #55566a;
  }

  .not-found-title {
    font-family: "Poppins", sans-serif;
    font-size: 20px;
    font-weight: 700;
    color: #f0f0f8;
    margin-bottom: 8px;
  }

  .not-found-sub {
    font-size: 14px;
    color: #55566a;
    line-height: 1.6;
  }

  .back-btn {
    display: inline-block;
    padding: 12px 24px;
    background: #1e1e2e;
    color: #a78bfa;
    font-family: "Poppins", sans-serif;
    font-size: 14px;
    font-weight: 600;
    border-radius: 12px;
    text-decoration: none;
    transition: background 0.2s;
  }

  .back-btn:hover {
    background: #252535;
  }
</style>
