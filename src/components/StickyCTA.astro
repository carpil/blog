<!-- Botón CTA Sticky para mobile -->
<div class="sticky-cta fixed bottom-0 left-0 right-0 z-40 md:hidden bg-white border-t border-gray-200 shadow-lg">
  <div class="container mx-auto px-4 py-3">
    <a
      href="#waitlist"
      class="w-full inline-flex px-6 py-3 bg-primary text-white rounded-lg font-heading font-bold text-base hover:bg-[#5A3FD9] transition-colors shadow-md items-center justify-center"
      aria-label="Quiero acceso anticipado"
    >
      Quiero acceso anticipado
    </a>
  </div>
</div>

<style>
  /* Ocultar el sticky CTA cuando el usuario está en el hero */
  @media (max-width: 768px) {
    .sticky-cta {
      display: block;
    }
    
    /* Opcional: Ocultar cuando está en el viewport del hero */
    /* Esto requeriría JavaScript, pero por ahora lo dejamos visible siempre en mobile */
  }
</style>
