---
import TrackView from "../components/booking/TrackView";
import WhatsAppLead from "../components/booking/WhatsAppLead";
import Face from "../components/ride/Face";
import RideCard, { DRIVER_COLORS } from "../components/ride/RideCard";
import NotFound from "../components/share/NotFound.astro";
import ShareRow from "../components/share/ShareRow.astro";
import ShareLayout from "../layouts/ShareLayout.astro";
import { getDriverPage } from "../lib/api";
import { freeSeats, seatsLeftLabel } from "../lib/format";
import { rideCardProps } from "../lib/ride-card";
import { driverWhatsappMessage } from "../lib/ride-copy";
import { driverUrl } from "../lib/share-links";

// Static routes (/ride, /privacy, /api…) win over this one, and the API refuses to
// hand out a slug that collides with them.
const { slug } = Astro.params;
const page = slug ? await getDriverPage(slug) : null;
if (!page) Astro.response.status = 404;

const driver = page?.driver ?? null;
const rides = page?.rides ?? [];

const title = driver ? `Viajes de ${driver.firstName} — Carpil` : "Conductor no encontrado — Carpil";
const description = driver
  ? rides.length > 0
    ? `${driver.firstName} tiene ${rides.length === 1 ? "1 viaje" : `${rides.length} viajes`} próximos. Apartá tu campo sin descargar nada.`
    : `Mirá los próximos viajes de ${driver.firstName} y apartá tu campo sin descargar nada.`
  : "Este conductor no existe en Carpil.";
const ogImage = driver ? new URL(`/api/og/driver/${driver.slug}.png`, Astro.url.origin).href : undefined;

const memberSince = driver?.memberSince
  ? new Date(driver.memberSince).toLocaleDateString("es-CR", { month: "long", year: "numeric", timeZone: "America/Costa_Rica" })
  : null;
---

<ShareLayout title={title} description={description} image={ogImage} index={driver !== null}>
  {
    driver ? (
      <div class="page">
        <TrackView client:idle event="web_driver_page_opened" properties={{ driver_slug: driver.slug, rides: rides.length }} />
        <header class="nav">
          <a class="brand" href="/">
            <img class="brand__mark" src="/logo-carpil.png" alt="" width="32" height="32" />
            <span class="brand__name">Carpil</span>
          </a>
        </header>

        <section class="profile">
          <span class="profile__face">
            <Face name={driver.name} photo={driver.profilePicture} size={80} colors={DRIVER_COLORS} />
            {driver.kycVerified && (
              <span class="profile__verified" aria-label="Verificado">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="#2f009b" aria-hidden="true">
                  <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z" />
                </svg>
              </span>
            )}
          </span>
          <div class="profile__text">
            <h1 class="profile__name">{driver.name}</h1>
            {driver.averageRating != null && driver.ratingsCount > 0 && (
              <p class="profile__meta profile__rating">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="#ffb691" aria-hidden="true">
                  <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" />
                </svg>
                {driver.averageRating.toFixed(1)} · {driver.ratingsCount}{" "}
                {driver.ratingsCount === 1 ? "calificación" : "calificaciones"}
              </p>
            )}
            {memberSince && <p class="profile__meta">Conductor desde {memberSince}</p>}
          </div>
        </section>

        <section class="rides">
          <h2 class="rides__title">Próximos viajes</h2>
          {rides.length === 0 && (
            <p class="rides__empty">
              {driver.firstName} no tiene viajes publicados por ahora. Escribile por WhatsApp para saber cuándo sale.
            </p>
          )}
          {rides.map((ride) => {
            const seats = freeSeats(ride);
            return (
              <RideCard
                {...rideCardProps(ride, driver)}
                note={seatsLeftLabel(seats)}
                noteTone={seats > 0 ? "warm" : "muted"}
                cta={seats > 0 ? "Reservar" : undefined}
                href={`/ride/${ride.id}`}
              />
            );
          })}
        </section>

        {/* Below the rides on purpose: booking one comes first, chatting is the fallback. */}
        {driver.whatsapp && (
          <WhatsAppLead
            client:visible
            driverSlug={driver.slug ?? undefined}
            whatsapp={driver.whatsapp}
            message={driverWhatsappMessage(driver.firstName)}
            label={`Escribirle a ${driver.firstName} por WhatsApp`}
            context="driver_page"
          />
        )}

        {driver.slug && (
          <ShareRow
            label={`Compartí los viajes de ${driver.firstName}`}
            text={`Viajes de ${driver.firstName} en Carpil:`}
            title={title}
            url={driverUrl(driver.slug)}
            native={false}
          />
        )}
      </div>
    ) : (
      <div class="fallback">
        <NotFound title="Conductor no encontrado" message="Revisá el link que te pasaron o pedile uno nuevo al conductor." />
      </div>
    )
  }
</ShareLayout>

<style>
  .page {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: start;
    gap: 20px;
    max-width: 480px;
    margin: 0 auto;
    padding: 16px 20px 40px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .brand__mark {
    display: block;
    width: 32px;
    height: 32px;
    border-radius: 10px;
  }

  .brand__name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 22px;
    letter-spacing: -0.8px;
  }

  .profile {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .profile__face {
    position: relative;
    flex-shrink: 0;
    width: 80px;
    height: 80px;
  }

  .profile__face :global(.face) {
    font-size: 26px !important;
  }

  .profile__verified {
    position: absolute;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    box-sizing: border-box;
    border-radius: 9999px;
    background: var(--primary);
    border: 3px solid var(--surface);
  }

  .profile__text {
    min-width: 0;
  }

  .profile__name {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 26px;
    line-height: 32px;
    letter-spacing: -0.6px;
  }

  .profile__meta {
    margin: 0;
    font-size: 14px;
    line-height: 20px;
    color: var(--on-surface-variant);
  }

  .profile__rating {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-top: 4px;
  }

  .rides {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .rides__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 32px;
    line-height: 38px;
    letter-spacing: -0.4px;
  }

  .rides__empty {
    margin: 0;
    padding: 20px;
    border-radius: 20px;
    background: var(--surface-container-low);
    border: 1px solid var(--border-ghost);
    font-size: 15px;
    line-height: 21px;
    color: var(--on-surface-variant);
  }

  .fallback {
    max-width: 420px;
    margin: 0 auto;
    padding: 56px 24px;
  }
</style>
