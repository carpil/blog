---
import type { Ride, PublicDriverCard, RideWebState } from "../../types/ride";
import { CLOSED_COPY, rideWhatsappMessage } from "../../lib/ride-copy";
import WhatsAppLead from "./WhatsAppLead";

interface Props {
  ride: Ride;
  driver: PublicDriverCard;
  state: Exclude<RideWebState, "open">;
}

const { ride, driver, state } = Astro.props;
const copy = CLOSED_COPY[state];
---

<div class="closed">
  <p class="closed__title">{copy.title}</p>
  <p class="closed__message">{copy.message(driver.firstName)}</p>
  {
    driver.whatsapp && (
      <WhatsAppLead
        client:load
        rideId={ride.id}
        driverFirstName={driver.firstName}
        whatsapp={driver.whatsapp}
        message={rideWhatsappMessage(driver.firstName, ride)}
        label={`Escribirle a ${driver.firstName}`}
        context="ride_closed"
        variant="primary"
      />
    )
  }
  {
    driver.slug && (
      <a class="closed__link" href={`/${driver.slug}`}>
        Ver otros viajes de {driver.firstName}
      </a>
    )
  }
</div>

<style>
  .closed {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 20px;
    border-radius: 24px;
    background: var(--surface-container-low);
    border: 1px solid var(--border-ghost);
  }

  .closed__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 20px;
    line-height: 26px;
  }

  .closed__message {
    margin: 0;
    font-size: 15px;
    line-height: 21px;
    color: var(--on-surface-variant);
  }

  .closed__link {
    align-self: center;
    padding: 8px 12px;
    font-weight: 600;
    font-size: 15px;
    color: var(--primary);
  }
</style>
