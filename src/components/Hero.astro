---

---

<section class="hero bg-white py-12 lg:py-20 relative">
  <div class="container mx-auto px-4 w-full">
    <div class="max-w-4xl mx-auto text-center">
      <!-- Banner simplificado -->
      <div
        class="inline-flex items-center gap-2 px-4 py-2 bg-primary/10 border border-primary/20 rounded-full mb-6"
      >
        <span class="text-xl">🚗</span>
        <span class="font-body text-sm text-primary font-medium">
          Acceso anticipado disponible
        </span>
      </div>

      <!-- Slogan principal - Emocional y memorable -->
      <h1
        class="font-heading text-4xl lg:text-6xl font-extrabold mb-6 leading-tight"
      >
        <span class="text-dark">Viajamos juntos.</span>
        <br />
        <span class="text-primary">Ahorramos juntos.</span>
      </h1>

      <!-- Beneficios como badges sutiles - Reemplaza el párrafo -->
      <div class="flex flex-wrap justify-center gap-2 mb-8 max-w-2xl mx-auto">
        <span
          class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-primary/5 border border-primary/10 rounded-full text-sm text-dark font-medium"
        >
          <span class="text-base">💰</span>
          <span>Ahorrá hasta 60%</span>
        </span>
        <span
          class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-primary/5 border border-primary/10 rounded-full text-sm text-dark font-medium"
        >
          <span class="text-base">🚗</span>
          <span>Reducí tráfico</span>
        </span>
        <span
          class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-primary/5 border border-primary/10 rounded-full text-sm text-dark font-medium"
        >
          <span class="text-base">🌱</span>
          <span>Reducí CO₂</span>
        </span>
      </div>

      <!-- CTA Button - Refinado y balanceado -->
      <div class="mb-8">
        <a
          href="#waitlist"
          class="inline-flex px-8 py-3 bg-primary text-white rounded-lg font-heading font-bold text-lg lg:text-xl hover:bg-[#5A3FD9] transition-colors shadow-md hover:shadow-lg min-h-[48px] items-center justify-center"
          aria-label="Quiero acceso anticipado"
        >
          Quiero acceso anticipado
        </a>
      </div>

      <!-- App Store Badges - En la misma línea para igualdad de plataformas -->
      <div
        class="flex flex-row flex-wrap gap-2 sm:gap-4 justify-center items-center mb-8"
      >
        <button
          disabled
          class="flex items-center gap-2 sm:gap-3 px-4 sm:px-6 py-3 bg-gray-100 border-2 border-gray-200 rounded-lg opacity-50 cursor-not-allowed min-w-[140px] sm:min-w-[160px]"
        >
          <svg
            class="w-7 h-7 sm:w-8 sm:h-8 flex-shrink-0"
            viewBox="0 0 24 24"
            fill="currentColor"
          >
            <path
              d="M17.05 20.28c-.98.95-2.05.88-3.08.4-1.09-.5-2.08-.48-3.24 0-1.44.62-2.2.44-3.06-.4C1.79 15.25 2.28 7.59 9.5 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09l.01-.01zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"
            ></path>
          </svg>
          <div class="text-left">
            <div class="font-body text-xs text-carpil-gray">PRÓXIMAMENTE</div>
            <div class="font-heading text-sm font-bold text-dark">
              App Store
            </div>
          </div>
        </button>

        <button
          disabled
          class="flex items-center gap-2 sm:gap-3 px-4 sm:px-6 py-3 bg-gray-100 border-2 border-gray-200 rounded-lg opacity-50 cursor-not-allowed min-w-[140px] sm:min-w-[160px]"
        >
          <svg
            class="w-7 h-7 sm:w-8 sm:h-8 flex-shrink-0"
            viewBox="0 0 24 24"
            fill="currentColor"
          >
            <path
              d="M3,20.5V3.5C3,2.91 3.34,2.39 3.84,2.15L13.69,12L3.84,21.85C3.34,21.6 3,21.09 3,20.5M16.81,15.12L6.05,21.34L14.54,12.85L16.81,15.12M20.16,10.81C20.5,11.08 20.75,11.5 20.75,12C20.75,12.5 20.53,12.9 20.18,13.18L17.89,14.5L15.39,12L17.89,9.5L20.16,10.81M6.05,2.66L16.81,8.88L14.54,11.15L6.05,2.66Z"
            ></path>
          </svg>
          <div class="text-left">
            <div class="font-body text-xs text-carpil-gray">PRÓXIMAMENTE</div>
            <div class="font-heading text-sm font-bold text-dark">
              Google Play
            </div>
          </div>
        </button>
      </div>

      <!-- Indicador visual de scroll -->
      <div class="flex justify-center mt-8">
        <a
          href="#waitlist"
          class="flex flex-col items-center gap-2 text-gray-400 hover:text-gray-500 transition-colors"
          aria-label="Scroll para unirte a la waitlist"
        >
          <span class="text-xs font-body font-normal opacity-70"
            >Unite a la waitlist</span
          >
          <svg
            class="w-5 h-5 animate-bounce opacity-60"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
