# Carpil API (server-side fetches for the pages and OG images)
API_URL=https://dev-api.carpil.app/v1

# Booking from the browser (public, inlined at build time)
PUBLIC_API_URL=https://dev-api.carpil.app/v1
PUBLIC_FIREBASE_API_KEY=
# www.carpil.app in production (served through the /__/auth proxy); the
# <project>.firebaseapp.com domain everywhere else, which makes sign-in use a popup.
PUBLIC_FIREBASE_AUTH_DOMAIN=carpil-ef6b9.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=carpil-ef6b9
PUBLIC_FIREBASE_APP_ID=
# Firestore database the booking island listens to: (default) for dev, prod in production
PUBLIC_FIRESTORE_DATABASE_ID=(default)
# Local only: point Auth and Firestore at the emulators (make dev/firebase), e.g. localhost
PUBLIC_FIREBASE_EMULATOR_HOST=
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Resend API Configuration
RESEND_API_KEY=re_your_resend_api_key_here

# Resend Segment IDs
GENERAL_SEGMENT_ID=your_general_segment_id_here
WEEKLY_UPDATES_SEGMENT_ID=your_weekly_updates_segment_id_here

# Resend Topic IDs
WEEKLY_UPDATES_TOPIC_ID=your_weekly_update_topic_id_here
